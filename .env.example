# mutual-review-mcp — environment variable template
#
# This tool reads STANDARD ENVIRONMENT VARIABLES. It does not auto-load this
# file; load it with your own tooling (direnv, dotenv, docker --env-file, or
# copy the lines into your shell profile / MCP client "env" block).
#
# 本ツールは通常の環境変数を読みます。このファイル自体を自動読み込みは
# しません(direnv / dotenv / MCP クライアントの env 設定などで読み込むか、
# シェルに export してください)。
#
# Required / 必須
ANTHROPIC_API_KEY=CHANGE-ME
OPENAI_API_KEY=CHANGE-ME

# Optional / 任意
# MUTUAL_REVIEW_CLAUDE_MODEL=claude-sonnet-4-6
# MUTUAL_REVIEW_GPT_MODEL=gpt-4o
# ENABLE_COST_TRACKING=0
# COST_LOG_PATH=/path/to/usage.jsonl
# MUTUAL_REVIEW_CONFIG=/path/to/config.json
